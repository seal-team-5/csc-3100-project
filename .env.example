MONGO_URI=mongodb://127.0.0.1:27017/recipeme
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
# For HTTPS deployment only: set TRUST_PROXY to the actual trusted proxy network.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google login (optional). Create an OAuth client of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   <APP_ORIGIN>/api/auth/google/callback