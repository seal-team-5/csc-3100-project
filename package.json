{
  "name": "scheduling-project",
  "version": "1.0.0",
  "description": "RecipeMe: a user puts in their meal preferences (could be dietary restrictions, cuisine type, dietary goals, time commitment, taste profile, specific food preferences, budget, store preferences, expertise, appliances, themed-food, serving size, amount of pots used) - App will output recipe ideas based on preferences - Each recipe will come with a grocery list (with stores nearby = - - where you can purchase the items), prioritize one store - Save recipes that you really like to your favorites - Rate recipes to change their recommendation frequency. Can add recipes to cart",
  "homepage": "https://github.com/seal-team-5/scheduling-project#readme",
  "bugs": {
    "url": "https://github.com/seal-team-5/scheduling-project/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seal-team-5/scheduling-project.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:server": "npm run dev",
    "dev:client": "npm --prefix packages/client run dev",
    "build": "npm --prefix packages/client run build",
    "test": "node --test packages/server/*.test.js packages/client/src/lib/*.test.ts",
    "test:recipes": "node --env-file=.env --test packages/server/integration/recipes.test.js",
    "format": "npx prettier . --write",
    "lint": "npx eslint . && npx prettier --check .",
    "start": "node --env-file=.env packages/server/index.js",
    "dev": "node --watch --env-file=.env packages/server/index.js",
    "dev:demo": "node packages/server/demo.js",
    "test:reviews:db": "node --env-file=.env --test packages/server/integration/reviews.test.js",
    "build:api": "esbuild vercel/entry.js --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.7",
    "eslint-config-google": "^0.14.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "mongoose": "^9.11.0",
    "node": "^22.23.3",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "mockingoose": "^3.0.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "mongodb-memory-server@11.3.0": true,
    "@swc/core@1.16.22": true
  }
}
